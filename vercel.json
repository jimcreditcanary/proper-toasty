{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "crons": [
    {
      "path": "/api/cron/release-stale-leads",
      "schedule": "*/30 * * * *"
    },
    {
      "path": "/api/cron/outreach/select-batch",
      "schedule": "0 8 * * *"
    },
    {
      "path": "/api/cron/outreach/send-queue",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/cron/outreach/follow-up",
      "schedule": "0 7 * * *"
    },
    {
      "path": "/api/cron/social-agent",
      "schedule": "0 7 * * 1,3,5"
    },
    {
      "path": "/api/cron/social-watchdog",
      "schedule": "0 8 * * 2,4,6"
    },
    {
      "path": "/api/cron/blog-generator",
      "schedule": "0 9 * * 0"
    }
  ]
}
